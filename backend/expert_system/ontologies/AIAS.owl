    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/AIAS#Actuator"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/AIAS#CloudSystem"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/AIAS#ComputerSystem"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/AIAS#Controller"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/AIAS#EdgeDevice"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/AIAS#PersonalComputer"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/AIAS#Sensor"/>
        </owl:members>
    </rdf:Description>
</rdf:RDF>



