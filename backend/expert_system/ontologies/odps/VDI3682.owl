    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#AlternativeFlow</IRI>
        <Literal xml:lang="de">tbd.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Assignment</IRI>
        <Literal xml:lang="de">Ein Assignment ist eine strukturelle Verbindung zwischen Prozessoperator und technischer Ressource, über die einer Ressource die Ausführung eines Prozessoperators zugewiesen wird.

**Quelle (Norm):** VDI 3682, Kapitel 4.2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Energy</IRI>
        <Literal xml:lang="de">tbd.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Flow</IRI>
        <Literal xml:lang="de">Ein Flow ist eine gerichtete Verbindung von Produkten zwischen Prozessoperatoren.

**Quelle (Norm):** VDI 3682, Kapitel 4.1, Seite 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Information</IRI>
        <Literal xml:lang="de">tbd.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ParallelFlow</IRI>
        <Literal xml:lang="de">tbd.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Process</IRI>
        <Literal xml:lang="de">Ein Process ist ein Netz zur Beschreibung technischer Prozesse, dessen Knoten die Zustände von Produkten und dessen gerichtete Kanten die Umwandlungsschritte durch Prozessoperatoren darstellen.

**Quelle (Norm):** VDI 3682, Kapitel 4.1, Seite 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ProcessOperator</IRI>
        <Literal xml:lang="de">Ein ProcessOperator ist ein Vorgang, durch den der Eingangszustand von Produkten, Energien oder Informationen in einen Ausgangszustand umgewandelt wird.

**Quelle (Norm):** VDI 3682, Kapitel 4.1, Seite 8f</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Product</IRI>
        <Literal xml:lang="de">Ein Product sind Dinge der realen Welt, die im Rahmen eines technischen Prozesses umgewandelt werden.

**Quelle (Norm):** VDI 3682, Kapitel 4.1, Seite 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#State</IRI>
        <Literal xml:lang="de">tbd.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SystemBorder</IRI>
        <Literal xml:lang="de">tbd.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TechnicalRessource</IRI>
        <Literal xml:lang="de">Eine TechnicalResource sind physische Komponenten, aus denen automatisierte Anlagen aufgebaut sind und die die Umwandlungen der Produkte durch Prozessoperatoren realisieren.

**Quelle (Norm):** VDI 3682, Kapitel 4.2</Literal>
    </AnnotationAssertion>
</Ontology>



