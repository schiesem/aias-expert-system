        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#AIComponent"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#AISystem"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#AIType"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#Data"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#DataSet"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#DataSink"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#DataSource"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#EvaluationMetric"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#Function"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#Hyperparameter"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#LearningType"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#MLAlgorithm"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#MLModel"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/ISO22989#MachineLearning"/>
