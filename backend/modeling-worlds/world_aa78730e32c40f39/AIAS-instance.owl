         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/schieseck/AIAS"
         xmlns="http://www.semanticweb.org/schieseck/AIAS#"
         xmlns:VDI3="http://www.semanticweb.org/schieseck/VDI3682#">

<owl:Ontology rdf:about="http://www.semanticweb.org/schieseck/AIAS">
  <owl:imports rdf:resource="http://www.semanticweb.org/schieseck/ISO22989"/>
  <owl:imports rdf:resource="http://www.semanticweb.org/schieseck/ISO7489"/>
  <owl:imports rdf:resource="http://www.semanticweb.org/schieseck/VDI3682"/>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#communicatesWith"/>

<owl:ObjectProperty rdf:about="#hasCommunication">
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/schieseck/ISO7489#Communication"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasComponent">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/schieseck/ISO22989#AISystem"/>
  <rdfs:range rdf:resource="#Component"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFlow">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Function"/>
        <rdf:Description rdf:about="#Process"/>
        <rdf:Description rdf:about="#Resource"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/schieseck/VDI3682#Product"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.semanticweb.org/schieseck/VDI3682#Flow"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasFunction">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/schieseck/ISO22989#AISystem"/>
  <rdfs:range rdf:resource="#Function"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInputCommunication">
  <rdfs:subPropertyOf rdf:resource="#hasCommunication"/>
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/schieseck/ISO7489#Communication"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates incoming communication (from target to source)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOutputCommunication">
  <rdfs:subPropertyOf rdf:resource="#hasCommunication"/>
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/schieseck/ISO7489#Communication"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indicates outgoing communication (from source to target)</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasProduct">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/schieseck/VDI3682#Flow"/>
  <rdfs:range rdf:resource="http://www.semanticweb.org/schieseck/VDI3682#Product"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasRelation">
  <rdfs:domain rdf:resource="http://www.semanticweb.org/schieseck/ISO22989#AISystem"/>
  <rdfs:range rdf:resource="#Relation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAssignedBy"/>

<owl:ObjectProperty rdf:about="#isAssignedTo">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Component"/>
        <rdf:Description rdf:about="#Function"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range rdf:resource="http://www.semanticweb.org/schieseck/VDI3682#Assignment"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#hasName">
  <rdfs:domain rdf:resource="#Component"/>
  <rdfs:domain rdf:resource="#Relation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Human-readable display name for the element</rdfs:comment>
</owl:DatatypeProperty>

<owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>

<owl:Class rdf:about="#Component">
  <rdfs:comment xml:lang="de">Eine Component ist ein Bauelement eines Systems, das eine bestimmte Aufgabe erfüllt und durch Relationen mit anderen Komponenten verbunden ist.

**Quelle:** Haberfellner, Systems Engineering</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Function">
  <rdfs:comment xml:lang="de">Eine Function beschreibt das Verhalten eines Systems oder einer Komponente, also was das System tut oder leisten soll, unabhängig von seiner konkreten Realisierung.

**Quelle:** Haberfellner, Systems Engineering</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Process">
  <rdfs:subClassOf rdf:resource="#Function"/>
  <rdfs:comment xml:lang="de">Ein Process ist eine spezielle Function, die eine Folge von Aktivitäten zur Umwandlung von Eingaben in Ausgaben beschreibt.

**Quelle:** Haberfellner, Systems Engineering</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Resource">
  <owl:equivalentClass rdf:resource="http://www.semanticweb.org/schieseck/VDI3682#TechnicalRessource"/>
  <rdfs:subClassOf rdf:resource="#Component"/>
  <rdfs:comment xml:lang="de">Eine Resource ist eine technische Komponente, die physische oder virtuelle Mittel zur Ausführung von Funktionen bereitstellt. Sie ist äquivalent zur TechnicalRessource aus VDI 3682.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Relation">
  <rdfs:comment xml:lang="de">Eine Relation beschreibt die Beziehung zwischen Systemelementen, insbesondere zwischen Komponenten oder zwischen Funktionen und Komponenten.

**Quelle:** Haberfellner, Systems Engineering</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Actuator">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <rdfs:comment xml:lang="de">Ein Actuator ist eine technische Ressource, die Signale oder Befehle in physische Aktionen umwandelt, um den Zustand eines Systems oder seiner Umgebung zu verändern.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CloudSystem">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <rdfs:comment xml:lang="de">Ein CloudSystem ist eine technische Ressource, die Rechen- und Speicherkapazitäten über ein Netzwerk bereitstellt und skalierbare Dienste für die Verarbeitung und Speicherung von Daten ermöglicht.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ComputerSystem">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <rdfs:comment xml:lang="de">Ein ComputerSystem ist eine technische Ressource, die Datenverarbeitung und -speicherung ermöglicht und als Oberbegriff für verschiedene Rechnertypen dient.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Controller">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <rdfs:comment xml:lang="de">Ein Controller ist eine technische Ressource, die als speicherprogrammierbare Steuerung (SPS) oder Industriesteuerung die Automatisierung von Prozessen ermöglicht.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EdgeDevice">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <rdfs:comment xml:lang="de">Ein EdgeDevice ist eine technische Ressource, die Datenverarbeitung am Rand des Netzwerks (Edge) durchführt, um Latenzzeiten zu reduzieren und lokale Entscheidungen zu ermöglichen.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ExternalCloud">
  <rdfs:subClassOf rdf:resource="#CloudSystem"/>
  <rdfs:comment xml:lang="de">Eine ExternalCloud ist ein CloudSystem, das von einem externen Anbieter betrieben wird und dessen Infrastruktur außerhalb der Organisationsgrenzen liegt.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InternalCloud">
  <rdfs:subClassOf rdf:resource="#CloudSystem"/>
  <rdfs:comment xml:lang="de">Eine InternalCloud ist ein CloudSystem, das innerhalb der eigenen Organisationsinfrastruktur betrieben wird und vollständig unter eigener Kontrolle steht.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PersonalComputer">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <rdfs:comment xml:lang="de">Ein PersonalComputer ist eine technische Ressource in Form eines Einzelplatzrechners, der für die Interaktion mit Benutzern und die lokale Datenverarbeitung eingesetzt wird.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Sensor">
  <rdfs:subClassOf rdf:resource="#Resource"/>
  <rdfs:comment xml:lang="de">Ein Sensor ist eine technische Ressource, die physikalische oder chemische Größen erfasst und in verarbeitbare Signale umwandelt.

**Quelle:** Dissertation Schieseck</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/schieseck/VDI3682#ProcessOperator">
  <rdfs:subClassOf rdf:resource="#Function"/>
  <rdfs:comment xml:lang="de">Im AIAS-Alignment: VDI3682:ProcessOperator ist eine Spezialisierung von AIAS:Function und beschreibt Umwandlungsvorgänge von Zuständen gemäß der Formalisierung technischer Prozesse nach VDI 3682.

**Quelle:** Dissertation Schieseck (AIAS-Alignment)</rdfs:comment>
</owl:Class>

