<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/schieseck/AIAS#"
     xml:base="http://www.semanticweb.org/schieseck/AIAS"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
