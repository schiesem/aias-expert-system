# SHACL Note Rules - Advisory Warnings for AI System Design
# Based on human_readable_notes.txt
# These rules generate informational warnings/hints, not hard violations

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix AIAS:     <http://www.semanticweb.org/schieseck/AIAS#> .
@prefix ISO22989: <http://www.semanticweb.org/schieseck/ISO22989#> .
@prefix ISO7489:  <http://www.semanticweb.org/schieseck/ISO7489#> .
@prefix VDI3682:  <http://www.semanticweb.org/schieseck/VDI3682#> .

# ==============================================================================
# RULES 1-3: Inference on CloudSystem
# ==============================================================================

# Rule 1: Inference on CloudSystem - Latency
AIAS:InferenceOnCloudSystemLatencyShape
    a sh:NodeShape ;
    rdfs:label "Rule 1: Inference on CloudSystem - Latency" ;
    sh:targetClass ISO22989:Inference ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Bei der Inferenz auf einer externen Cloud können hohe Latenzzeiten auftreten." ;
        sh:select """
            PREFIX AIAS: <http://www.semanticweb.org/schieseck/AIAS#>
            PREFIX ISO22989: <http://www.semanticweb.org/schieseck/ISO22989#>
            PREFIX VDI3682: <http://www.semanticweb.org/schieseck/VDI3682#>
            SELECT $this ?assignment ?component
            WHERE {
                $this AIAS:isAssignedTo ?assignment .
                ?assignment a VDI3682:Assignment .
                ?component AIAS:isAssignedTo ?assignment .
                ?component a AIAS:CloudSystem .
            }
        """ ;
    ] .

# Rule 2: Inference on CloudSystem - Reliability
AIAS:InferenceOnCloudSystemReliabilityShape
    a sh:NodeShape ;
    rdfs:label "Rule 2: Inference on CloudSystem - Reliability" ;
    sh:targetClass ISO22989:Inference ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Bei der Inferenz auf einer externen Cloud ist keine Ausfallsicherheit gegeben. Sobald die Verbindung zur Cloud oder der Anlage abbricht, kann die Inferenz nicht ausgeführt werden." ;
        sh:select """
            PREFIX AIAS: <http://www.semanticweb.org/schieseck/AIAS#>
            PREFIX ISO22989: <http://www.semanticweb.org/schieseck/ISO22989#>
            PREFIX VDI3682: <http://www.semanticweb.org/schieseck/VDI3682#>
            SELECT $this ?assignment ?component
            WHERE {
                $this AIAS:isAssignedTo ?assignment .
                ?assignment a VDI3682:Assignment .
                ?component AIAS:isAssignedTo ?assignment .
                ?component a AIAS:CloudSystem .
            }
        """ ;
    ] .

# Rule 3: Inference on CloudSystem - Costs
AIAS:InferenceOnCloudSystemCostsShape
    a sh:NodeShape ;
    rdfs:label "Rule 3: Inference on CloudSystem - Costs" ;
    sh:targetClass ISO22989:Inference ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Möglicherweise hohe Kosten durch kontinuierliche und unsachgemäße Nutzung der Cloud. Bitte Anwenderzugang prüfen." ;
        sh:select """
            PREFIX AIAS: <http://www.semanticweb.org/schieseck/AIAS#>
            PREFIX ISO22989: <http://www.semanticweb.org/schieseck/ISO22989#>
            PREFIX VDI3682: <http://www.semanticweb.org/schieseck/VDI3682#>
            SELECT $this ?assignment ?component
            WHERE {
                $this AIAS:isAssignedTo ?assignment .
                ?assignment a VDI3682:Assignment .
                ?component AIAS:isAssignedTo ?assignment .
                ?component a AIAS:CloudSystem .
            }
        """ ;
    ] .

# ==============================================================================
# RULES 4-5: Inference on EdgeDevice
# ==============================================================================

# Rule 4: Inference on EdgeDevice - Computing Power
AIAS:InferenceOnEdgeDevicePowerShape
    a sh:NodeShape ;
    rdfs:label "Rule 4: Inference on EdgeDevice - Computing Power" ;
    sh:targetClass ISO22989:Inference ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Die verfügbare Rechenleistung auf dem Edge-Gerät ist eventuell nicht ausreichend um das Modell auszuführen. Bitte die Rechenleistung prüfen." ;
        sh:select """
            PREFIX AIAS: <http://www.semanticweb.org/schieseck/AIAS#>
            PREFIX ISO22989: <http://www.semanticweb.org/schieseck/ISO22989#>
            PREFIX VDI3682: <http://www.semanticweb.org/schieseck/VDI3682#>
            SELECT $this ?assignment ?component
            WHERE {
                $this AIAS:isAssignedTo ?assignment .
                ?assignment a VDI3682:Assignment .
                ?component AIAS:isAssignedTo ?assignment .
                ?component a AIAS:EdgeDevice .
            }
        """ ;
    ] .

# Rule 5: Inference on EdgeDevice - Computing Duration
AIAS:InferenceOnEdgeDeviceDurationShape
    a sh:NodeShape ;
    rdfs:label "Rule 5: Inference on EdgeDevice - Computing Duration" ;
    sh:targetClass ISO22989:Inference ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Die verfügbare Rechenleistung auf dem Edge-Gerät ist eventuell nicht ausreichend um das Modell in der geforderten Zeit auszuführen. Bitte die Rechendauer prüfen." ;
        sh:select """
            PREFIX AIAS: <http://www.semanticweb.org/schieseck/AIAS#>
            PREFIX ISO22989: <http://www.semanticweb.org/schieseck/ISO22989#>
            PREFIX VDI3682: <http://www.semanticweb.org/schieseck/VDI3682#>
            SELECT $this ?assignment ?component
            WHERE {
                $this AIAS:isAssignedTo ?assignment .
                ?assignment a VDI3682:Assignment .
                ?component AIAS:isAssignedTo ?assignment .
                ?component a AIAS:EdgeDevice .
            }
        """ ;
    ] .

# ==============================================================================
# RULE 6: Training on EdgeDevice
# ==============================================================================

AIAS:TrainingOnEdgeDeviceShape
    a sh:NodeShape ;
    rdfs:label "Rule 6: Training on EdgeDevice" ;
    sh:targetClass ISO22989:Training ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Die Rechenleistung auf dem Gerät ist eventuell nicht ausreichend für das Training." ;
        sh:select """
            PREFIX AIAS: <http://www.semanticweb.org/schieseck/AIAS#>
            PREFIX ISO22989: <http://www.semanticweb.org/schieseck/ISO22989#>
            PREFIX VDI3682: <http://www.semanticweb.org/schieseck/VDI3682#>
            SELECT $this ?assignment ?component
            WHERE {
                $this AIAS:isAssignedTo ?assignment .
                ?assignment a VDI3682:Assignment .
                ?component AIAS:isAssignedTo ?assignment .
                ?component a AIAS:EdgeDevice .
            }
        """ ;
    ] .

